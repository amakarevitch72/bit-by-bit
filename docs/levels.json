    { "n": 17, "chapter": 4, "id": "register", "title": "Register", "status": "not_designed", "expected": "4 DFF sharing a clock and a load enable", "unlocks": "REG4" },
    { "n": 18, "chapter": 4, "id": "counter", "title": "Counter & clock", "status": "not_designed", "expected": "REG4 + ADD4 (+1) loop", "unlocks": "CNT4" },

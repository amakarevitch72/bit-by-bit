    { "n": 2, "chapter": 1, "id": "or", "title": "OR gate", "desc": "2 transistors in parallel", "status": "built_in_app", "implementation": "ui/screens/TransistorWorkbench.kt + HardWorkbench.kt; sim TransistorPairBoard", "kind": "transistor_wiring", "inputs": ["A", "B"], "outputs": ["OUT"], "choices": ["SERIES", "PARALLEL"], "start": { "wiring": null }, "solution": "PARALLEL", "wrongChoiceHint": "Stacked means current must pass through A and then B — that is the AND gate from Level 1.", "expected": "OUT = A OR B", "test": { "type": "truth_table_manual", "rows": 4, "clearsOn": "wiring change" }, "unlocks": "OR" },
    { "n": 3, "chapter": 1, "id": "not", "title": "NOT gate", "desc": "Flip a signal", "status": "built_in_app", "implementation": "ui/screens/NotWorkbench.kt; sim InverterBoard (Normal only)", "kind": "transistor", "inputs": ["A"], "outputs": ["OUT"], "expected": "OUT = NOT A", "test": { "type": "truth_table_manual", "rows": 2 }, "unlocks": "NOT" },
    { "n": 4, "chapter": 1, "id": "nand_nor", "title": "NAND & NOR", "desc": "The universal gates", "status": "built_in_app", "implementation": "ui/screens/SocketWorkbench.kt + HardWorkbench.kt; sim SocketLevels.NAND_NOR", "kind": "chips", "tray": ["AND", "OR", "NOT"], "expected": "NAND = NOT(A AND B); NOR = NOT(A OR B)", "test": { "type": "truth_table_manual", "rows": 4 }, "unlocks": ["NAND", "NOR"] },
    { "n": 5, "chapter": 1, "id": "xor", "title": "XOR gate", "desc": "One or the other, not both", "status": "built_in_app", "implementation": "ui/screens/SocketWorkbench.kt + HardWorkbench.kt; sim SocketLevels.XOR", "kind": "chips", "tray": ["AND", "OR", "NAND", "NOR"], "solution": "(A OR B) AND (A NAND B)", "test": { "type": "truth_table_manual", "rows": 4 }, "unlocks": "XOR" },
    {
      "n": 6, "chapter": 2, "id": "half_adder", "title": "Half adder", "desc": "Sum + carry of two bits",
      "status": "built_in_app", "implementation": "ui/screens/HalfAdderWorkbench.kt + HardWorkbench.kt; sim HalfAdderBoard", "mockup": ["design/HalfAdder.dc.html"], "kind": "chips",
      "inputs": ["A", "B"], "outputs": ["S", "C"],
      "sockets": [{ "id": "s", "drives": "S", "inputs": ["A", "B"] }, { "id": "c", "drives": "C", "inputs": ["A", "B"] }],
      "tray": ["XOR", "AND", "OR", "NAND"],
      "start": { "sockets": { "s": "XOR", "c": null } },
      "solution": { "s": "XOR", "c": "AND" },
      "test": { "type": "truth_table_manual", "rows": 4, "columns": "A B | want C S | got C S" },
      "unlocks": "HA"
    },
    {
      "n": 7, "chapter": 2, "id": "full_adder", "title": "Full adder", "desc": "Add a carry-in",
      "status": "built_in_app", "implementation": "ui/screens/SocketWorkbench.kt + HardWorkbench.kt; sim SocketLevels.FULL_ADDER", "mockup": ["design/FullAdder.dc.html"], "kind": "chips",
      "inputs": ["A", "B", "Cin"], "outputs": ["S", "Cout"],
      "sockets": [
        { "id": "h1", "inputs": ["A", "B"], "outputs": ["S1", "C1"] },
        { "id": "h2", "inputs": ["S1", "Cin"], "outputs": ["S", "C2"] },
        { "id": "g", "inputs": ["C1", "C2"], "outputs": ["Cout"] }
      ],
      "tray": ["HA", "OR", "AND", "XOR"],
      "start": { "sockets": { "h1": "HA", "h2": null, "g": null } },
      "solution": { "h1": "HA", "h2": "HA", "g": "OR" },
      "alsoAccepted": [{ "g": "XOR", "bonus": "It adds — and XOR works too! (C1 and C2 are never both 1)" }],
      "test": { "type": "run_all", "cases": 8 },
      "unlocks": "FA"
    },
    {
      "n": 8, "chapter": 2, "id": "adder4", "title": "4-bit adder", "desc": "Chain four full adders",
      "status": "built_in_app", "implementation": "ui/screens/MultiBitWorkbenches.kt (Adder4Workbench); sim Adder4Board", "mockup": ["design/Adder4.dc.html"], "kind": "chips_columns",
      "inputs": ["A[4]", "B[4]"], "outputs": ["S[4]", "Cout"],
      "sockets": "one per bit (0–3)", "links": "carry link bit k → bit k+1 (k = 0..2); Cin of bit 0 = 0",
      "tray": ["FA", "HA", "OR"],
      "start": { "a": 5, "b": 3, "sockets": ["FA", "FA", null, null], "links": [true, false, false] },
      "solution": { "sockets": ["FA", "FA", "FA", "FA"], "links": [true, true, true] },
      "alsoAccepted": [{ "sockets[0]": "HA", "bonus": "Bit 0 has no carry-in, so HA is enough there." }],
      "test": { "type": "exhaustive", "cases": 256, "check": "S + 16*Cout == A + B", "failMessage": "e.g. {a} + {b} gave {got}, want {want}" },
      "unlocks": "ADD4"
    },
    {
      "n": 9, "chapter": 2, "id": "subtractor", "title": "Subtractor", "desc": "Two's complement",
      "status": "built_in_app", "implementation": "ui/screens/MultiBitWorkbenches.kt (SubtractorWorkbench); sim SubtractorBoard", "mockup": ["design/Subtractor.dc.html"], "kind": "chips_columns",
      "inputs": ["A[4]", "B[4]"], "outputs": ["R[4]", "Cout"], "fixedParts": ["ADD4"],
      "sockets": "one per B line (bit 0–3), between B and ADD4", "controls": ["Cin toggle", "Signed view toggle"],
      "tray": ["NOT", "XOR (2nd pin tied to 1)", "AND"],
      "start": { "a": 7, "b": 5, "sockets": [null, null, null, "NOT"], "cin": 0 },
      "solution": { "sockets": ["NOT", "NOT", "NOT", "NOT"], "cin": 1 },
      "alsoAccepted": [{ "sockets": "XOR anywhere", "bonus": "XOR + a switch = add OR subtract!" }],
      "test": { "type": "exhaustive", "cases": 256, "check": "R == (A − B) mod 16", "hint": "append '(off by one?)' when Cin = 0" },
      "unlocks": "SUB4"
    },
    { "n": 10, "chapter": 3, "id": "comparator", "title": "Comparator", "status": "not_designed", "expected": "A < B, A = B flags for 4-bit A, B", "test": { "type": "exhaustive", "cases": 256 }, "unlocks": "CMP4" },
    { "n": 11, "chapter": 3, "id": "seg7", "title": "7-segment decoder", "status": "not_designed", "expected": "digit 0–9 → segments a–g (see Calculator.dc.html MAP)", "test": { "type": "exhaustive", "cases": 10 }, "unlocks": "SEG7" },
    { "n": 12, "chapter": 3, "id": "alu4", "title": "4-bit ALU", "status": "not_designed", "expected": "op 0 = ADD, op 1 = SUB (XOR on B with op, Cin = op)", "test": { "type": "exhaustive", "cases": 512 }, "unlocks": "ALU4" },
    { "n": 13, "chapter": 3, "id": "keypad", "title": "Keypad encoder", "status": "not_designed", "expected": "key 0–9 → 4-bit code", "test": { "type": "exhaustive", "cases": 10 }, "unlocks": "KEYENC" },
    {

{
  "version": 1,
  "notes": "Level definitions. 'mockup' = approved screen in design/. 'status': designed | not_designed. Chip ids are used in 'tray', 'solution' and 'unlocks'. Bits are LSB = index 0.",
  "chips": {
    "TRANSISTOR": { "symbol": "T", "name": "Transistor", "inputs": ["base"], "outputs": [], "builtFrom": "starting part" },
    "AND": { "symbol": "&", "inputs": ["A", "B"], "outputs": ["Y"], "builtFrom": "2 transistors" },
    "OR": { "symbol": "≥1", "inputs": ["A", "B"], "outputs": ["Y"], "builtFrom": "2 transistors" },
    "NOT": { "symbol": "1○", "inputs": ["A"], "outputs": ["Y"], "builtFrom": "1 transistor" },
    "NAND": { "symbol": "&○", "inputs": ["A", "B"], "outputs": ["Y"], "builtFrom": "AND + NOT" },
    "NOR": { "symbol": "≥1○", "inputs": ["A", "B"], "outputs": ["Y"], "builtFrom": "OR + NOT" },
    "XOR": { "symbol": "=1", "inputs": ["A", "B"], "outputs": ["Y"], "builtFrom": "NAND, OR, AND" },
    "HA": { "symbol": "HA", "name": "Half adder", "inputs": ["A", "B"], "outputs": ["S", "C"], "builtFrom": "XOR + AND" },
    "FA": { "symbol": "FA", "name": "Full adder", "inputs": ["A", "B", "Cin"], "outputs": ["S", "Cout"], "builtFrom": "2 HA + OR" },
    "ADD4": { "symbol": "Σ4", "name": "4-bit adder", "inputs": ["A[4]", "B[4]", "Cin"], "outputs": ["S[4]", "Cout"], "builtFrom": "4 FA" },
    "SUB4": { "symbol": "−4", "name": "4-bit subtractor", "builtFrom": "ADD4 + 4 NOT, Cin = 1" },
    "CMP4": { "symbol": "<", "name": "Comparator" },
    "SEG7": { "symbol": "8.", "name": "7-segment decoder" },
    "ALU4": { "symbol": "ALU", "name": "4-bit ALU" },
    "KEYENC": { "symbol": "⌨", "name": "Keypad encoder" },
    "LATCH": { "symbol": "SR", "name": "SR latch", "inputs": ["S", "R"], "outputs": ["Q", "Q̄"], "builtFrom": "2 NOR + feedback" },
    "DFF": { "symbol": "D", "name": "D flip-flop" },
    "REG4": { "symbol": "R4", "name": "4-bit register" },
    "CNT4": { "symbol": "+1", "name": "Counter" },
    "RAM16": { "symbol": "RAM", "name": "16-byte RAM" }
  },
  "chapters": [
    { "id": 1, "title": "Logic gates", "blurb": "Wire transistors into the gates every chip is made of." },
    { "id": 2, "title": "Arithmetic", "blurb": "Combine your gates until bits can add up." },
    { "id": 3, "title": "Calculator", "milestone": true, "blurb": "Decode digits, build an ALU, wire a keypad — then use the calculator you made." },
    { "id": 4, "title": "Memory", "blurb": "Feed outputs back into inputs so a circuit can remember." },
    { "id": 5, "title": "Mini computer", "milestone": true, "blurb": "Assemble a tiny CPU from your own chips and run a program on it." }
  ],
  "levels": [
    {
      "n": 1, "chapter": 1, "id": "and", "title": "AND gate", "desc": "2 transistors in series",
      "status": "built_in_app", "implementation": "ui/screens/TransistorWorkbench.kt + HardWorkbench.kt; sim TransistorPairBoard", "mockup": ["design/Lesson.dc.html", "design/Workbench.dc.html", "design/Complete.dc.html"],
      "kind": "transistor", "inputs": ["A", "B"], "outputs": ["OUT"],
      "board": "+5V → Q1 (base A) → Q2 (base B) → LED → GND; pre-wired in Level 1",

      "status": "designed", "mockup": ["design/SRLatch.dc.html"], "kind": "sequential",
      "inputs": ["S (pulse)", "R (pulse)"], "outputs": ["Q", "Q̄"],
      "sockets": [{ "id": "top", "inputs": ["R", "Q̄ via loop 2"], "outputs": ["Q"] }, { "id": "bot", "inputs": ["Q via loop 1", "S"], "outputs": ["Q̄"] }],
